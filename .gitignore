# Python environments and caches
.venv/
.venv-win/
.venv-wsl/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Build output and temporary working files
build/
dist/
submission/
tmp/
output/

# Default interactive/replay outputs; retained examples live under examples/.
/replay.html
/replay.png
/interactive.png
/interactive.csv
/interactive.json
.coverage
htmlcov/

# Credentials and local configuration
.env
.env.*
!.env.example

# Final measured results, figures and evidence should be deliberately tracked.
demo/*.mp4
demo/*.gif

# LaTeX auxiliaries from direct editor builds; PDF and TeX sources are retained.
report/**/*.aux
report/**/*.bbl
report/**/*.blg
report/**/*.fls
report/**/*.fdb_latexmk
report/**/*.lof
report/**/*.log
report/**/*.lot
report/**/*.out
report/**/*.toc
report/**/*.synctex.gz
